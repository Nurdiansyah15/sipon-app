# Base URL of the sipon-be API, including the /api/v1 prefix.
# sipon-be listens on APP_EXPOSE_PORT (default 8081) locally.
#
# Android emulator -> host machine:
# API_BASE_URL=http://10.0.2.2:8081/api/v1
#
# iOS simulator -> host machine:
# API_BASE_URL=http://localhost:8081/api/v1
#
# Physical device on the same LAN -> use the host machine's LAN IP:
# API_BASE_URL=http://192.168.x.x:8081/api/v1
API_BASE_URL=http://10.0.2.2:8081/api/v1
